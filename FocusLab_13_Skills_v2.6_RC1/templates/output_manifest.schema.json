{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FocusLab v2.6 RC1 output manifest",
  "type": "object",
  "required": [
    "run_id",
    "skill_id",
    "version",
    "topic_id",
    "input_refs",
    "output_files",
    "evidence",
    "open_issues",
    "gate_status",
    "next_skill",
    "approval_status",
    "test_status",
    "field_status"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "skill_id": {
      "type": "string",
      "pattern": "^SKILL(0[1-9]|1[0-3])$"
    },
    "version": {
      "const": "2.6-rc1"
    },
    "topic_id": {
      "type": "string",
      "minLength": 1
    },
    "input_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "version",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "output_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "status",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
          },
          "status": {
            "enum": [
              "READY_REFERENCE",
              "READY_ASSET",
              "PROTOTYPE",
              "SPEC_ONLY",
              "BLOCKED",
              "NOT_APPLICABLE"
            ]
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "READY_REFERENCE",
                    "READY_ASSET",
                    "PROTOTYPE"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "SPEC_ONLY",
                    "BLOCKED",
                    "NOT_APPLICABLE"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "reason"
              ]
            }
          }
        ]
      }
    },
    "evidence": {
      "type": "array"
    },
    "open_issues": {
      "type": "array"
    },
    "gate_status": {
      "enum": [
        "DRAFT",
        "PROTOTYPE",
        "NEEDS_REVIEW",
        "TESTED_AUTOMATED",
        "VERIFIED_IN_PRACTICE",
        "BLOCKED"
      ]
    },
    "next_skill": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^SKILL(0[1-9]|1[0-3])$"
    },
    "approval_status": {
      "enum": [
        "NOT_REQUESTED",
        "PENDING",
        "USER_APPROVED",
        "REJECTED"
      ]
    },
    "test_status": {
      "enum": [
        "NOT_RUN",
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "field_status": {
      "enum": [
        "NOT_RUN",
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "applicability": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "status",
          "reason"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "const": "NOT_APPLICABLE"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "gate_status": {
            "const": "VERIFIED_IN_PRACTICE"
          }
        }
      },
      "then": {
        "properties": {
          "field_status": {
            "const": "PASS"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "gate_status": {
            "const": "TESTED_AUTOMATED"
          }
        }
      },
      "then": {
        "properties": {
          "test_status": {
            "const": "PASS"
          }
        }
      }
    }
  ]
}
