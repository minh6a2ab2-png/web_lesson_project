{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FocusLab v2.7 pedagogical contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "skill_id",
    "topic_id",
    "scope",
    "status",
    "ku_ids",
    "source_refs",
    "decisions",
    "limitations"
  ],
  "properties": {
    "version": {
      "const": "2.7-rc1"
    },
    "skill_id": {
      "pattern": "^SKILL(0[1-9]|1[0-3])$",
      "type": "string"
    },
    "topic_id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "enum": [
        "DESIGN_ONLY",
        "SYNTHETIC_ONLY"
      ]
    },
    "status": {
      "enum": [
        "DRAFT",
        "NEEDS_REVIEW",
        "BLOCKED",
        "CANDIDATE"
      ]
    },
    "ku_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "ref",
          "version",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "requirement",
          "decision",
          "evidence_refs"
        ],
        "properties": {
          "requirement": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  }
}
